# ---------- OpenAI / Cost Control ----------
OPENAI_API_KEY=sk-...
# Cost-first defaults. Current official API models; override if your account uses different aliases.
OPENAI_MODEL_ECONOMY=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5.4-mini
OPENAI_MODEL_VISION=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# false = free browser voice when available; true = OpenAI TTS
NEXT_PUBLIC_PREMIUM_TTS=false
JARVIS_MODEL_MODE=AUTO
JARVIS_DAILY_BUDGET_USD=0.50
JARVIS_MONTHLY_BUDGET_USD=10
OPENAI_ECONOMY_INPUT_USD_PER_MTOK=0.25
OPENAI_ECONOMY_OUTPUT_USD_PER_MTOK=2
OPENAI_SMART_INPUT_USD_PER_MTOK=0.75
OPENAI_SMART_OUTPUT_USD_PER_MTOK=4.5

# ---------- Supabase (SERVER ONLY) ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------- Single owner ----------
JARVIS_OWNER_ID=11111111-1111-1111-1111-111111111111
JARVIS_ACCESS_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JARVIS_PAIRING_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
JARVIS_TIMEZONE=Europe/Istanbul
# Fixed routines chosen for this build: morning 09:30, evening 19:00 Europe/Istanbul.

# ---------- Google OAuth: Gmail + Calendar (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---------- Web Push ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=CHANGE_THIS_CRON_SECRET

# ---------- Home Assistant (optional) ----------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWLIST=light.,switch.
