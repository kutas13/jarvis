# Local test: http://localhost:3000
# Production: https://YOUR-VERCEL-DOMAIN.vercel.app
JARVIS_URL=http://localhost:3000

# First run only: same value as server JARVIS_PAIRING_SECRET
JARVIS_PAIRING_SECRET=03102005
JARVIS_DEVICE_TOKEN=
DEVICE_NAME=Furkan-PC
POLL_SECONDS=2

# File indexing. Semicolon-separated folders. These stay on your PC; only filenames + limited searchable excerpts are synced.
INDEX_ROOTS=%USERPROFILE%\\Documents;%USERPROFILE%\\Desktop;%USERPROFILE%\\Downloads
INDEX_INTERVAL_SECONDS=600
MAX_INDEX_FILES=1200

# Desktop interaction is only executed after approval from the web dashboard.
ENABLE_DESKTOP_AUTOMATION=true
